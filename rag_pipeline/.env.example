# Supabase service access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Beta worker/API guardrail
BETA_FROZEN=false

# Embeddings for semantic refinement and durable dense retrieval
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# Gemini option. To try Gemini Embedding, set:
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
GEMINI_OUTPUT_DIMENSIONALITY=1536

# Active retrieval index. Supabase remains the source of truth.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=learncycle_chunks
SPARSE_PROVIDER=fastembed
SPARSE_MODEL=Qdrant/bm25
SPARSE_VECTOR_NAME=sparse
SPARSE_ENABLED=true
HYBRID_FUSION=rrf
HYBRID_PREFETCH_LIMIT=30
HYBRID_TOP_K=10
QDRANT_NATIVE_HYBRID_ENABLED=true

# Internal API auth
RAG_INTERNAL_API_KEY=dev-secret-change-me
RAG_DEBUG_TIMING_ENABLED=false

# Retrieval timeouts and caches
VECTOR_RETRIEVE_TIMEOUT_S=4.0
GRAPH_RETRIEVE_TIMEOUT_S=2.0
MEMORY_RETRIEVE_TIMEOUT_S=1.5
WEB_RETRIEVE_TIMEOUT_S=4.0
RERANK_TIMEOUT_S=1.5
QUERY_EMBEDDING_CACHE_ENABLED=true
QUERY_EMBEDDING_CACHE_MAX_ENTRIES=512
RETRIEVAL_RESULT_CACHE_ENABLED=true
RETRIEVAL_RESULT_CACHE_MAX_ENTRIES=512
RETRIEVAL_RESULT_CACHE_TTL_S=300
RERANKER_CACHE_ENABLED=true
RERANKER_CACHE_MAX_ENTRIES=512
RERANKER_CACHE_TTL_S=300

# Reranking
RERANKING_ENABLED=false
RERANKING_PROVIDER=noop
RERANKING_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANKING_CANDIDATE_K=30
RERANKING_TOP_K=8
RERANKER_NORMAL_MODE_DEFAULT=noop

# Chat memory and prompt compaction
CHAT_MEMORY_ENABLED=false
CHAT_MEMORY_SUMMARY_THRESHOLD=8
CHAT_MEMORY_SUMMARY_INTERVAL=4
CHAT_MEMORY_KEEP_RECENT=4
CHAT_MEMORY_MAX_SUMMARY_CHARS=2500
CHAT_MEMORY_RETRIEVAL_ENABLED=false
CHAT_MEMORY_DEFAULT_INCLUDED=false
CHAT_MEMORY_TOP_K=2
CHAT_MEMORY_SOURCE_TYPE=chat_memory
PROMPT_COMPACTION_ENABLED=false
PROMPT_COMPACTION_THRESHOLD=12
PROMPT_COMPACTION_INTERVAL=4
PROMPT_COMPACTION_KEEP_RECENT=6
PROMPT_COMPACTION_MAX_SUMMARY_CHARS=1500

# GraphRAG and Learning Graph
GRAPH_ENABLED=false
GRAPH_EXTRACTION_ENABLED=false
GRAPH_RETRIEVAL_ENABLED=false
GRAPH_STORE_PROVIDER=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_MAX_NODES_PER_CHUNK=12
GRAPH_MAX_EDGES_PER_CHUNK=20
GRAPH_RETRIEVAL_TOP_K=8
GRAPH_CONTEXT_MAX_CHARS=6000
GRAPH_SOURCE_TYPE=knowledge_graph
LEARNING_GRAPH_EXTRACTION_ENABLED=false
LEARNING_GRAPH_MAX_CHUNKS_PER_GROUP=20
LEARNING_GRAPH_MIN_CONFIDENCE=0.55
LEARNING_GRAPH_MAX_TOPICS_PER_DOC=60
LEARNING_GRAPH_MIN_CHUNK_COVERAGE=0.35

# Web search
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_TOP_K=5
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_QUERY_CHARS=300
WEB_SEARCH_MAX_CONTEXT_SOURCES=5
WEB_SEARCH_MAX_CHARS_PER_SOURCE=1000
WEB_SEARCH_MAX_TOTAL_CONTEXT_CHARS=4000
WEB_SEARCH_SOURCE_TYPE=web
TAVILY_API_KEY=

# Intent classifier
INTENT_CLASSIFIER_ENABLED=false
INTENT_CLASSIFIER_PROVIDER=openai
INTENT_CLASSIFIER_MODEL=gpt-4.1-mini
INTENT_CLASSIFIER_TIMEOUT_SECONDS=10
INTENT_CLASSIFIER_MAX_RECENT_MESSAGES=4
INTENT_CLASSIFIER_MAX_MESSAGE_CHARS=1000
INTENT_CLASSIFIER_FALLBACK_ENABLED=true

# Retrieval planner and controlled tool registry
RETRIEVAL_PLANNER_ENABLED=false
RETRIEVAL_PLANNER_DEFAULT_TOP_K=6
RETRIEVAL_PLANNER_PDF_TOP_K=6
RETRIEVAL_PLANNER_NOTES_TOP_K=4
RETRIEVAL_PLANNER_ANNOTATIONS_TOP_K=4
RETRIEVAL_PLANNER_MEMORY_TOP_K=3
RETRIEVAL_PLANNER_WEB_TOP_K=5
RETRIEVAL_PLANNER_MAX_STEPS=5
RETRIEVAL_PLANNER_INCLUDE_DISABLED_STEPS=true
RETRIEVAL_TOOL_REGISTRY_ENABLED=false
RETRIEVAL_TOOL_TIMEOUT_SECONDS=20
RETRIEVAL_TOOL_MAX_RESULTS_PER_TOOL=20
RETRIEVAL_TOOL_ALLOWED_TOOLS=

# Controlled agentic retriever
AGENTIC_RETRIEVER_ENABLED=false
AGENTIC_RETRIEVER_MODE=controlled
AGENTIC_RETRIEVER_QUALITY_ASSESSMENT_MODE=heuristic
AGENTIC_RETRIEVER_REFINEMENT_MODE=heuristic
AGENTIC_RETRIEVER_LLM_MODEL=gpt-4.1-mini
AGENTIC_RETRIEVER_LLM_TIMEOUT_SECONDS=10
AGENTIC_RETRIEVER_LLM_FALLBACK_TO_HEURISTIC=true
AGENTIC_RETRIEVER_MAX_REFINEMENT_ROUNDS=1
AGENTIC_RETRIEVER_MAX_TOOL_CALLS=8
AGENTIC_RETRIEVER_MIN_TOTAL_RESULTS=3
AGENTIC_RETRIEVER_MIN_AVG_SCORE=0.25
AGENTIC_RETRIEVER_MAX_LATENCY_SECONDS=30

# Revision
REVISION_LLM_MODEL=gpt-4o-mini
REVISION_MAX_CARDS_PER_DECK=30
REVISION_MAX_QUESTIONS_PER_TEST=20
REVISION_RETRIEVAL_TOP_K=8

# Worker loop
RAG_WORKER_POLL_INTERVAL_SECONDS=2.0
RAG_WORKER_MAX_JOBS_PER_LOOP=10
RAG_WORKER_IDLE_BACKOFF_MAX_SECONDS=30.0
RAG_WORKER_MAX_ATTEMPTS=3

# Chunking
RAG_CHUNKING_STRATEGY=docling_hybrid_semantic_refinement
RAG_CHUNKING_VERSION=v1
